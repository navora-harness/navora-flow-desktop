{
  "name": "navora-flow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Navora",
  "description": "Navora Flow — visual flow executor with pluggable runtime libraries",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:install": "node scripts/electron-install.mjs",
    "electron:dev": "node scripts/dev.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.1",
    "navora-flow-library-sdk": "file:../navora-flow-library-sdk",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^34.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=20"
  }
}
